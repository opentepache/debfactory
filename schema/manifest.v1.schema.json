{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debfactory.invalid/schema/manifest.v1.schema.json",
  "title": "debfactory package manifest v1",
  "description": "Un manifiesto por paquete en packages/<name>.yaml. Plantillas permitidas en strings marcadas como 'templated': {{version}}, {{tag}}, {{arch}}; además {{name}} solo en install[].src cuando artifact.format es 'binary'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "revision",
    "level",
    "summary",
    "description",
    "homepage",
    "upstream",
    "license",
    "value"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "const": 2
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "required": [
          "justification",
          "source"
        ]
      },
      "else": {
        "required": [
          "arch_map",
          "artifact",
          "install"
        ]
      }
    }
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "description": "Nombre del paquete Debian; también el nombre del archivo del manifiesto.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+.-]+$",
      "not": {
        "description": "Nombres reservados por las rutas del sitio web (specs/006-repo-website, research D3).",
        "enum": [
          "assets",
          "es"
        ]
      }
    },
    "version": {
      "description": "Versión upstream sin prefijo 'v'.",
      "type": "string",
      "pattern": "^[0-9][A-Za-z0-9.+]*$"
    },
    "revision": {
      "description": "N en <upstream>-0~tepache<N> (no es la revisión Debian, que siempre es 0). Empieza en 1 y se reinicia con cada versión upstream.",
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "description": "Nivel de construcción (constitución II): 1 reempaqueta el binario oficial; 2 compila desde el código fuente con la carpeta debian/ de packages/<name>/ y exige justification (specs/008-source-builds).",
      "enum": [
        1,
        2
      ]
    },
    "summary": {
      "description": "Sinopsis de una línea (Description de Debian). Sin punto final. El artículo inicial se valida en Go (el motor de regex de Go no tiene lookahead).",
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[^\\n]*[^.\\n]$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "section": {
      "type": "string",
      "default": "devel"
    },
    "upstream": {
      "description": "Repositorio de GitHub 'owner/repo'. Fase 1: solo GitHub.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tag": {
      "description": "Plantilla del tag upstream (templated: {{version}}).",
      "type": "string",
      "default": "v{{version}}"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "file"
      ],
      "properties": {
        "spdx": {
          "description": "Expresión SPDX esperada, p. ej. 'MIT' o 'MIT OR Apache-2.0'.",
          "type": "string",
          "minLength": 2
        },
        "file": {
          "description": "Fuente del texto de licencia de la versión exacta: exactamente una de 'archive' o 'repo'.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "archive": {
              "description": "Ruta dentro del artefacto (templated).",
              "type": "string"
            },
            "repo": {
              "description": "Ruta en el repo upstream al tag exacto.",
              "type": "string"
            }
          }
        },
        "copyright": {
          "description": "Línea de copyright si no puede extraerse del texto de licencia.",
          "type": "string"
        }
      }
    },
    "value": {
      "description": "Justificación de valor (constitución V): no al día en Debian estable, sin repo APT del autor, no en repos comunitarios conocidos.",
      "type": "string",
      "minLength": 20
    },
    "justification": {
      "description": "Nivel 2: por qué no basta el binario oficial (constitución II).",
      "type": "string",
      "minLength": 20
    },
    "source": {
      "description": "Nivel 2: tarball del código fuente del release (se verifica con source_sha256 del lockfile).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "format"
      ],
      "properties": {
        "url": {
          "description": "URL del tarball (templated: {{version}}, {{tag}}).",
          "type": "string",
          "pattern": "^https://"
        },
        "format": {
          "enum": [
            "tar.gz",
            "tar.xz",
            "tar.bz2"
          ]
        }
      }
    },
    "build": {
      "description": "Nivel 2: ajustes de la compilación.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmpfs": {
          "description": "Tamaño del tmpfs de compilación, p. ej. 8g; ≤ level2.tmpfs_max.",
          "type": "string",
          "pattern": "^[1-9][0-9]*[mg]$"
        }
      }
    },
    "arch_map": {
      "description": "Arquitectura Debian -> token upstream usado como {{arch}}. Ambas arquitecturas son obligatorias.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "amd64": {
          "type": "string",
          "minLength": 1
        },
        "arm64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "amd64",
        "arm64"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "format"
      ],
      "properties": {
        "url": {
          "description": "URL del asset (templated). Debe empezar por https://github.com/<upstream>/releases/download/{{tag}}/.",
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "format": {
          "enum": [
            "binary",
            "zip",
            "tar.gz"
          ]
        }
      }
    },
    "checksums": {
      "description": "Archivo de checksums publicado por upstream. Si se omite, solo se verifica contra el lockfile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "format"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "format": {
          "enum": [
            "sha256sum"
          ]
        }
      }
    },
    "install": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/installItem"
      }
    },
    "completions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bash": {
          "$ref": "#/$defs/completion"
        },
        "zsh": {
          "$ref": "#/$defs/completion"
        },
        "fish": {
          "$ref": "#/$defs/completion"
        }
      }
    },
    "man": {
      "description": "Globs (templated) de man pages dentro del artefacto; la sección se toma de la extensión.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends": {
      "$ref": "#/$defs/relations"
    },
    "recommends": {
      "$ref": "#/$defs/relations"
    },
    "conflicts": {
      "$ref": "#/$defs/relations"
    },
    "replaces": {
      "$ref": "#/$defs/relations"
    },
    "provides": {
      "$ref": "#/$defs/relations"
    },
    "exclude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suites": {
          "$ref": "#/$defs/reasons"
        }
      },
      "description": "Solo se pueden excluir suites (constitución, Alcance); toda arquitectura soportada se construye y se prueba."
    },
    "test": {
      "description": "Por defecto: '<primer ejecutable en /usr/bin> --version' y la salida debe contener {{version}}.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "description": "Subcadena esperada (templated).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "watch": {
      "description": "Detector de versiones upstream (specs/005-upstream-release-watch, data-model.md §1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "false excluye el paquete del detector (se lista como omitido).",
          "type": "boolean",
          "default": true
        },
        "auto_merge": {
          "description": "Los PR de versión nueva se integran solos si pasan verify; nunca con un cambio de versión mayor, de licencia o de otros campos (FR-013–FR-015a).",
          "type": "boolean",
          "default": false
        },
        "prerelease_flag": {
          "description": "trust: se descarta lo que upstream marca como pre-release. ignore: esa marca no es fiable para este paquete. Nunca desactiva el filtro de marcadores preliminares en la versión (FR-003a).",
          "enum": [
            "trust",
            "ignore"
          ],
          "default": "trust"
        }
      }
    },
    "i18n": {
      "description": "Traducciones que solo usa el sitio web (specs/006-repo-website, contracts/config.md). summary y description son los del .deb, en inglés.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[^\\n]*[^.\\n]$"
            },
            "description": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    },
    "lintian_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "reason"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "$ref": "#/$defs/absPath"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "absPath": {
      "type": "string",
      "pattern": "^/(usr|etc|opt)/"
    },
    "installItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "dst"
      ],
      "properties": {
        "src": {
          "description": "Ruta o glob dentro del artefacto (templated). Con format=binary, el archivo descargado se llama '{{name}}'.",
          "type": "string"
        },
        "dst": {
          "description": "Ruta destino. Si termina en '/', es un directorio y se conserva el nombre de origen.",
          "$ref": "#/$defs/absPath"
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$",
          "description": "Por defecto: 0755 si el archivo de origen tiene el bit ejecutable, si no 0644."
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "file": {
          "description": "Ruta dentro del artefacto (templated).",
          "type": "string"
        },
        "generate": {
          "description": "Orden que imprime la completion; se ejecuta en contenedor sin red.",
          "type": "string"
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]+( \\((<<|<=|=|>=|>>) [^)]+\\))?( \\| [a-z0-9][a-z0-9+.-]+( \\((<<|<=|=|>=|>>) [^)]+\\))?)*$"
      }
    },
    "reasons": {
      "description": "Nombre -> motivo no vacío.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
