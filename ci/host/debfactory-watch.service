# Detector de versiones (specs/005-upstream-release-watch, research D3): lanza
# workflow_dispatch de watch.yml. Se dispara cada hora; el ciclo decide por sí
# mismo si ya venció watch.interval (24 h por defecto, config/debfactory.yaml),
# así el intervalo vive en el repositorio de paquetes y una PC apagada recupera
# el ciclo al encenderse. No hay on: schedule porque GitHub lo desactiva tras
# 60 días sin actividad.
[Unit]
Description=debfactory: detector de versiones upstream (workflow_dispatch de watch.yml)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=gh:/etc/credstore/debfactory-gh-runner
EnvironmentFile=/etc/default/debfactory-runner
ExecStart=/usr/local/lib/debfactory/dispatch.sh watch.yml '{}'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
